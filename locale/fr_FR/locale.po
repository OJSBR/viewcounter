msgid "plugins.generic.viewcounter.displayName"
msgstr "Compteur de vues"

msgid "plugins.generic.viewcounter.description"
msgstr "Affiche le nombre de vues et de téléchargements des articles, dans le résumé de l'article (listes) et sur la page de détails de l'article. Réécrit et adapté pour OJS 3.5 par OJSBR. Plugin original de STI FFLCH et ABCD/USP."

msgid "plugins.generic.viewcounter.settings"
msgstr "Paramètres du compteur de vues"

msgid "plugins.generic.viewcounter.settings.showInSummary"
msgstr "Afficher dans le résumé de l'article (listes d'articles)"

msgid "plugins.generic.viewcounter.settings.showInDetails"
msgstr "Afficher sur la page de détails de l'article"

msgid "plugins.generic.viewcounter.views"
msgstr "Vues"

msgid "plugins.generic.viewcounter.downloads"
msgstr "Téléchargements"
