msgid "plugins.generic.viewcounter.displayName"
msgstr "Contador de visitas"

msgid "plugins.generic.viewcounter.description"
msgstr "Muestra el número de visitas y descargas de los artículos, en el sumario del artículo (listas) y en la página de detalles del artículo. Reescrito y adaptado para OJS 3.5 por OJSBR. Plugin original de STI FFLCH y ABCD/USP."

msgid "plugins.generic.viewcounter.settings"
msgstr "Configuración del contador de visitas"

msgid "plugins.generic.viewcounter.settings.showInSummary"
msgstr "Mostrar en el sumario del artículo (listas de artículos)"

msgid "plugins.generic.viewcounter.settings.showInDetails"
msgstr "Mostrar en la página de detalles del artículo"

msgid "plugins.generic.viewcounter.views"
msgstr "Visitas"

msgid "plugins.generic.viewcounter.downloads"
msgstr "Descargas"
