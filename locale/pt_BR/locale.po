msgid "plugins.generic.viewcounter.displayName"
msgstr "Contador de visualizações"

msgid "plugins.generic.viewcounter.description"
msgstr "Exibe a quantidade de visualizações e downloads dos artigos, no resumo (listas) e na página de metadados do artigo. Reescrito e adaptado para o OJS 3.4/3.5 pela OJSBR. Plugin original de STI FFLCH e ABCD/USP."

msgid "plugins.generic.viewcounter.settings"
msgstr "Configurações do contador"

msgid "plugins.generic.viewcounter.settings.showInSummary"
msgstr "Exibir no resumo (listas de artigos)"

msgid "plugins.generic.viewcounter.settings.showInDetails"
msgstr "Exibir na página de metadados do artigo"

msgid "plugins.generic.viewcounter.views"
msgstr "Visualizações"

msgid "plugins.generic.viewcounter.downloads"
msgstr "Downloads"
