msgid "plugins.generic.viewcounter.displayName"
msgstr "Aufrufzähler"

msgid "plugins.generic.viewcounter.description"
msgstr "Zeigt die Anzahl der Aufrufe und Downloads von Artikeln an, in der Artikelübersicht (Listen) und auf der Artikeldetailseite. Neu geschrieben und angepasst für OJS 3.4/3.5 von OJSBR. Ursprüngliches Plugin von STI FFLCH und ABCD/USP."

msgid "plugins.generic.viewcounter.settings"
msgstr "Einstellungen des Aufrufzählers"

msgid "plugins.generic.viewcounter.settings.showInSummary"
msgstr "In der Artikelübersicht anzeigen (Artikellisten)"

msgid "plugins.generic.viewcounter.settings.showInDetails"
msgstr "Auf der Artikeldetailseite anzeigen"

msgid "plugins.generic.viewcounter.views"
msgstr "Aufrufe"

msgid "plugins.generic.viewcounter.downloads"
msgstr "Downloads"
