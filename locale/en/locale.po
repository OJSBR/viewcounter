msgid "plugins.generic.viewcounter.displayName"
msgstr "View counter"

msgid "plugins.generic.viewcounter.description"
msgstr "Displays the number of views and downloads of articles, in the article summary (lists) and on the article details page. Rewritten and adapted for OJS 3.4/3.5 by OJSBR. Original plugin by STI FFLCH and ABCD/USP."

msgid "plugins.generic.viewcounter.settings"
msgstr "View counter settings"

msgid "plugins.generic.viewcounter.settings.showInSummary"
msgstr "Show in the article summary (article lists)"

msgid "plugins.generic.viewcounter.settings.showInDetails"
msgstr "Show on the article details page"

msgid "plugins.generic.viewcounter.views"
msgstr "Views"

msgid "plugins.generic.viewcounter.downloads"
msgstr "Downloads"
